# Copy this file to `.env` and fill in your values.

# Anthropic API key — drives every model node in the agent.
ANTHROPIC_API_KEY="sk-ant-..."

# Which Claude model the agent uses. Override here without touching code.
# Default below is a sensible agent-loop choice; change to taste
# (e.g. claude-opus-4-8 for max capability, claude-haiku-4-5 for cheap/fast).
ANTHROPIC_MODEL="claude-sonnet-4-6"
